    "src/repository",
    "src/execution",
    "src/effect-adapter.ts",
    "src/digest.ts",
    "src/validation.ts",
    "contracts",
    "package.json",
    "tsconfig.json",
    "biome.json",
    ".node-version",
    ".go-version"
  ],
  "baseline_test_roots": [
    "test",
    "experiments/production-criticality-ranking",
    "experiments/semantic-scaling"
  ]
}
